{
  "name": "hmpps-electronic-monitoring-data-insights-ui",
  "version": "0.0.1",
  "description": "HMPPS Electronic Monitoring Data Insights Ui",
  "repository": "git@github.com:ministryofjustice/hmpps-electronic-monitoring-data-insights-ui.git",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "watch-ts": "tsc -w",
    "build": "node esbuild/esbuild.config.js --build",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild/esbuild.config.js --build --watch\" \"node esbuild/esbuild.config.js --dev-server\"",
    "start-feature": " node $NODE_DEBUG_OPTION --env-file=feature.env dist/server.js | bunyan -o short",
    "start-feature:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild/esbuild.config.js  --build --watch \" \"node esbuild/esbuild.config.js --dev-test-server\"",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests && tsc -p accessibility_tests",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:a11y": "playwright test -c playwright.config.ts",
    "test:a11y-ui": "playwright test -c playwright.config.ts --ui",
    "test:a11y-report": "playwright show-report test_results/playwright-accessibility/html",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "int-test": "cypress run --config video=false",
    "int-test-ui": "cypress open --e2e --browser chrome",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm i && npm run build",
    "setup": "npm ci && hmpps-npm-script-run-allowlist"
  },
  "engines": {
    "node": "^22 || ^24",
    "npm": "^10 || ^11"
  },
  "jest": {
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest"
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(ol|earcut|rbush|quickselect|@ministryofjustice/hmpps-electronic-monitoring-components)/)"
    ],
    "collectCoverageFrom": [
      "server/**/*.{ts,js,jsx,mjs}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/(server|job|assets)/**/?(*.)(cy|test).{ts,js,jsx,mjs}"
    ],
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test_results/jest/"
        }
      ],
      [
        "./node_modules/jest-html-reporter",
        {
          "outputPath": "test_results/unit-test-reports.html"
        }
      ]
    ],
    "moduleFileExtensions": [
      "web.js",
      "js",
      "json",
      "node",
      "ts"
    ]
  },
  "lint-staged": {
    "*.{ts,js,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.803.0",
    "@flipt-io/flipt-client-js": "0.5.0",
    "@microsoft/applicationinsights-clickanalytics-js": "3.4.2",
    "@microsoft/applicationinsights-web": "3.4.2",
    "@ministryofjustice/frontend": "9.0.0",
    "@ministryofjustice/hmpps-auth-clients": "^3.0.0",
    "@ministryofjustice/hmpps-electronic-monitoring-components": "0.2.18-beta.1",
    "@ministryofjustice/hmpps-monitoring": "2.1.0",
    "@ministryofjustice/hmpps-probation-frontend-components": "^1.0.0",
    "@ministryofjustice/hmpps-rest-client": "2.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "agentkeepalive": "^4.6.0",
    "applicationinsights": "^2.9.6",
    "body-parser": "^2.2.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "compression": "^1.8.0",
    "connect-flash": "^0.1.1",
    "connect-redis": "^8.0.3",
    "csrf-sync": "^4.2.0",
    "dayjs": "^1.11.13",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.18.1",
    "govuk-frontend": "6.2.0",
    "helmet": "^8.1.0",
    "hmpps-open-layers-map": "^0.8.7",
    "http-errors": "^2.0.0",
    "jwt-decode": "^4.0.0",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "ol": "^10.7.0",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "redis": "^4.7.0",
    "superagent": "^10.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@jgoz/esbuild-plugin-typecheck": "^4.0.3",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.3",
    "@playwright/test": "1.60.0",
    "@tsconfig/node22": "^22.0.1",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/compression": "^1.7.5",
    "@types/connect-flash": "0.0.40",
    "@types/express-session": "^1.18.1",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.12",
    "@types/nunjucks": "^3.2.6",
    "@types/papaparse": "^5.5.0",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.4.17",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^7.2.0",
    "audit-ci": "^7.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "chokidar": "^3.6.0",
    "concurrently": "^10.0.3",
    "cypress": "15.17.0",
    "cypress-multi-reporters": "^2.0.5",
    "esbuild": "^0.28.0",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.3.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-html-reporter": "^4.1.0",
    "jest-junit": "17.0.0",
    "jsonwebtoken": "^9.0.2",
    "lint-staged": "^15.5.1",
    "mocha-junit-reporter": "^2.2.1",
    "nock": "^14.0.4",
    "prettier": "^3.5.3",
    "prettier-plugin-jinja-template": "^2.1.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@jgoz/esbuild-plugin-typecheck": {
      "esbuild": "$esbuild"
    },
    "serialize-javascript": "7.0.5"
  }
}
